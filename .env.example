APP_NAME=Library Management API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_PREFIX=/api

# PostgreSQL / MySQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT settings - generate a strong random secret.
# The placeholder below is intentionally too short: the app will refuse to
# start until you replace it (run: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Borrowing business rules
MAX_ACTIVE_BORROWINGS=3
BORROW_DURATION_DAYS=14

# Rate limiting (per client IP per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=20